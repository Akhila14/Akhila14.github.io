---
import "@styles/global.css";
import { profile } from "@data/profile";

type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const {
  title = `${profile.name} - ${profile.role}`,
  description = profile.summary,
  image = "/og-image.svg"
} = Astro.props;

const enableFigmaCapture = process.env.PUBLIC_FIGMA_CAPTURE === "1";
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  email: profile.email,
  url: Astro.site?.toString(),
  image: new URL("/akhila-nair.jpg", Astro.site).toString(),
  sameAs: [profile.linkedin, profile.medium],
  knowsAbout: [
    "DevOps",
    "Kubernetes",
    "Platform Engineering",
    "Cloud Reliability",
    "AIOps",
    "Incident Management"
  ],
  availableAtOrFrom: profile.locationSignal
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4f0e5" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {enableFigmaCapture && (
      <script is:inline src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script is:inline>
      const root = document.documentElement;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      function setPointer(event) {
        if (reduce.matches) return;
        root.style.setProperty("--pointer-x", `${event.clientX}px`);
        root.style.setProperty("--pointer-y", `${event.clientY}px`);
      }
      window.addEventListener("pointermove", setPointer, { passive: true });
    </script>
  </body>
</html>
