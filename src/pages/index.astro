---
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import Footer from "@components/Footer.astro";
import {
  capabilities,
  caseStudies,
  certifications,
  experience,
  metrics,
  profile,
  sideProjects,
  writing
} from "@data/profile";
---

<BaseLayout>
  <SiteHeader />
  <main id="main" class="portfolio">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Senior DevOps Engineer · AI-native platform engineering</p>
        <h1 id="hero-title">I build systems that stay calm <em>under pressure.</em></h1>
        <p class="hero-lede">
          I’m Akhila Nair. I design cloud platforms, reliability systems, and AI-assisted operations for production
          environments where downtime is expensive and good decisions need evidence.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button button--primary" href="#work">Explore selected work <span aria-hidden="true">↘</span></a>
          <a class="button button--ghost" href={profile.resume} download>Download résumé</a>
        </div>
        <p class="hero-location">Based in Bangalore · Open to opportunities in Bangalore, Mumbai & Dubai</p>
      </div>

      <aside class="hero-portrait" aria-label="About Akhila">
        <div class="portrait-frame">
          <img src="/akhila-nair.jpg" alt={profile.portraitAlt} width="1600" height="2134" fetchpriority="high" />
        </div>
        <div class="portrait-caption">
          <span class="status-dot" aria-hidden="true"></span>
          <p><strong>Currently</strong> Senior DevOps Engineer at Razorpay</p>
        </div>
      </aside>
    </section>

    <section class="impact-strip" aria-label="Selected impact">
      {metrics.slice(0, 4).map((metric) => (
        <div class="impact-stat">
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </div>
      ))}
    </section>

    <section id="work" class="section work-section" aria-labelledby="work-title">
      <div class="section-intro">
        <p class="eyebrow"><span></span> Selected work</p>
        <h2 id="work-title">Reliability, made visible and repeatable.</h2>
        <p>
          My best work turns operational knowledge into systems teams can trust: evidence-backed checks, safer
          platform changes, and AI that reduces toil without removing human judgment.
        </p>
      </div>

      <div class="work-grid">
        {caseStudies.map((study, index) => (
          <a class={`project-card project-card--${index + 1}`} href={`/case-studies/${study.slug}/`}>
            <div class="project-topline">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span>{study.kicker}</span>
            </div>
            <div class="project-copy">
              <h3>{study.title}</h3>
              <p>{study.homepageSummary}</p>
            </div>
            <div class="project-result">
              <span>Outcome</span>
              <strong>{study.result}</strong>
              <i aria-hidden="true">↗</i>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section principles-section" aria-labelledby="principles-title">
      <div class="section-intro section-intro--compact">
        <p class="eyebrow eyebrow--light"><span></span> How I work</p>
        <h2 id="principles-title">AI should compress the toil, not hide the decision.</h2>
      </div>
      <ol class="principles-list">
        <li>
          <span>01</span>
          <div><strong>Start with evidence.</strong><p>Map incidents, risk, ownership, service signals, and the places where teams are forced to guess.</p></div>
        </li>
        <li>
          <span>02</span>
          <div><strong>Codify the repeatable.</strong><p>Turn expert judgment into checks, scorecards, upgrade paths, and observable workflows.</p></div>
        </li>
        <li>
          <span>03</span>
          <div><strong>Keep humans accountable.</strong><p>Let agents gather context and draft. Let engineers make the consequential call.</p></div>
        </li>
      </ol>
    </section>

    <section id="experience" class="section experience-section" aria-labelledby="experience-title">
      <div class="section-intro">
        <p class="eyebrow"><span></span> Experience</p>
        <h2 id="experience-title">Six years across cloud, platform, and production reliability.</h2>
      </div>
      <div class="timeline">
        {experience.map((role, index) => (
          <article class="timeline-item">
            <div class="timeline-marker"><span>{String(index + 1).padStart(2, "0")}</span></div>
            <div class="timeline-role">
              <p>{role.period}</p>
              <h3>{role.role}</h3>
              <strong>{role.company} · {role.location}</strong>
            </div>
            <ul>
              {role.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="credentials-row">
        <p><span>Education</span> M.S. Computer Engineering · University of Massachusetts Boston</p>
        <p><span>Certifications</span> {certifications.join(" · ")}</p>
      </div>
    </section>

    <section class="section capabilities-section" aria-labelledby="capabilities-title">
      <div class="section-intro section-intro--compact">
        <p class="eyebrow"><span></span> Core toolkit</p>
        <h2 id="capabilities-title">Deep infrastructure fluency, applied with product judgment.</h2>
      </div>
      <div class="capability-grid">
        {capabilities.map((capability, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{capability.group}</h3>
            <p>{capability.skills.join(" · ")}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="writing" class="section field-notes" aria-labelledby="writing-title">
      <div class="section-intro">
        <p class="eyebrow"><span></span> Building in public</p>
        <h2 id="writing-title">Experiments, tools, and field notes.</h2>
        <p>What I learn from building at the edge of infrastructure and AI—published as working software and honest notes.</p>
      </div>
      <div class="notes-layout">
        <div class="writing-list" aria-label="Selected writing">
          {writing.map((article, index) => (
            <a href={article.url} rel="noreferrer">
              <span>{String(index + 1).padStart(2, "0")} · {article.label}</span>
              <strong>{article.homeTitle}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
        <div class="side-projects" aria-label="Side projects">
          <p class="mini-label">Open-source side quests</p>
          {sideProjects.map((project) => (
            <a href={project.url} rel="noreferrer">
              <strong>{project.title}</strong>
              <span>{project.label}</span>
              <p>{project.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="section about-section">
      <figure>
        <img src="/akhila-about-chico.jpg" alt="Illustration of Akhila relaxing in a park with her dog Chico" loading="lazy" width="1200" height="800" />
        <figcaption>Outside the terminal: coffee, parks, and Chico.</figcaption>
      </figure>
      <div class="about-copy">
        <p class="eyebrow"><span></span> Beyond the systems</p>
        <h2>I like hard problems that become calm, useful tools.</h2>
        <p>
          I’m most at home where production reality meets new ideas: a risky release needs a clear gate, a fleet
          upgrade needs a safer rhythm, or an incident needs context before the next decision.
        </p>
        <p>
          I keep up with AI by building with it. Some experiments become internal platforms, some become open-source
          tools, and some become stories about what worked, what broke, and what humans still need to own.
        </p>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <p class="eyebrow eyebrow--light"><span></span> Let’s talk</p>
      <h2>Building systems that need to behave beautifully under pressure?</h2>
      <p>I’d love to hear about the problem.</p>
      <div class="contact-actions">
        <a class="button button--accent" href={`mailto:${profile.email}`}>Start a conversation <span aria-hidden="true">↗</span></a>
        <a href={profile.linkedin} rel="noreferrer">LinkedIn</a>
        <a href={profile.github} rel="noreferrer">GitHub</a>
        <a href={profile.medium} rel="noreferrer">Medium</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
